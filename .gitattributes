# 统一换行符：仓库内与检出都用 LF，避免 Windows 把文本存成 CRLF 后传到 Linux 执行/服务出错
* text=auto eol=lf

*.sh    text eol=lf
*.conf  text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.svg   text eol=lf
*.xml   text eol=lf
*.txt   text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.webmanifest text eol=lf

# 图片等二进制文件不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
